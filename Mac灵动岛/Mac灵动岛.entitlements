<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ============================================ -->
	<!-- Mac灵动岛 - Developer ID Entitlements         -->
	<!-- Not sandboxed; signed with Hardened Runtime  -->
	<!-- ============================================ -->

	<!-- Apple Events (AppleScript control of Music / Spotify, System Events paste) -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!-- Calendar Access (Hardened Runtime resource access) -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
